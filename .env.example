API_KEY=change-me

MODEL_ID=BAAI/bge-reranker-v2-m3
# MODEL_ID=Forturne/bge-reranker-v2-m3-FP8

# SERVED_MODEL_NAME=BAAI/bge-reranker-v2-m3

# HF_TOKEN=hf_xxx

# Safe DGX Spark / GPU déjà occupé.
GPU_MEMORY_UTILIZATION=0.25
MAX_MODEL_LEN=4096
MAX_NUM_SEQS=16
MAX_NUM_BATCHED_TOKENS=16384

# Defaults.
# DTYPE=auto
# ENFORCE_EAGER=1
# DISABLE_LOG_REQUESTS=1

# Seulement si mismatch FlashInfer.
# FLASHINFER_DISABLE_VERSION_CHECK=1

# Cache HF local au projet.
# HF_HOME=/home/ailab/api-reranker/.cache/huggingface
# HF_HUB_ENABLE_HF_TRANSFER=1
